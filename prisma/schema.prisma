generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Post {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  subtitle      String?
  category      String
  author        String?
  excerpt       String
  readTime      Int
  image         String
  imagePublicId String?
  pdfUrl        String?
  pdfPublicId   String?
  featured      Boolean    @default(false)
  status        PostStatus @default(DRAFT)
  content       Json
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([category, status])
  @@map("posts")
}

model Service {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions ContactSubmission[]

  @@map("services")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  message   String
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  isRead    Boolean  @default(false)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([isRead])
  @@map("contact_submissions")
}

enum EventLocationType {
  PHYSICAL
  VIRTUAL
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

model Event {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  tags            String[]
  host            String
  locationType    EventLocationType
  locationValue   String
  startDate       DateTime
  endDate         DateTime?
  image           String
  imagePublicId   String?
  excerpt         String
  description     Json
  registrationUrl String?
  status          EventStatus       @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, startDate])
  @@map("events")
}